# Template: copy to gateway.env and fill in. gateway.env is gitignored because it
# holds personal details (location, calendar ids). Non-secret gateway settings. Secrets (HARU_TERMINAL_TOKEN, HARU_LLM_API_KEY,
# HARU_BINVENTORY_API_TOKEN) live in config/secrets.env on the server only.
HARU_LOG_LEVEL=INFO

# The LLM: any OpenAI-compatible chat API (built and tuned against gpt-oss-120b).
# Behind an Open WebUI proxy the base is /api, not /v1: chat is POST {base}/chat/completions
# and the model list is GET {base}/models. Auth is "Authorization: Bearer $HARU_LLM_API_KEY".
HARU_LLM_BASE_URL=https://llm.example.com/v1
HARU_LLM_MODEL=gpt-oss-120b
# gpt-oss is a reasoning model. "low" roughly halved latency on conversational
# traffic with no tool-calling regression (measured 2026-08-03, median
# 1679ms -> 1028ms). Sent as extra_body {"reasoning_effort": ...}; leave it empty to omit.
HARU_LLM_REASONING_EFFORT=low
# How often the gateway checks the LLM is reachable (reported in backend.status).
HARU_LLM_HEALTH_INTERVAL_S=30

# Inbound audio. Stats (fps, loss, level, latency) are logged every N seconds.
HARU_AUDIO_STATS_INTERVAL_S=10
# Debug WAV recorder of the live mic. Off unless a directory is given. To turn it
# on, put HARU_AUDIO_RECORD_DIR=/data/recordings in config/overrides.env on the
# server (host path /opt/haru/data/recordings). It keeps the newest N 60-second segments.
HARU_AUDIO_RECORD_KEEP=10

# Speech-to-text (Stage 3): the `stt` container, OpenAI-compatible transcription API.
HARU_STT_BASE_URL=http://stt:8000/v1
# large-v3-turbo: measured 2026-09-29 on the 5070 Ti, as fast as small.en warm
# (~0.75 s for a 37 s clip), more accurate, and multilingual. Measured 2.4 GB VRAM loaded.
HARU_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
HARU_STT_LANGUAGE=en
# VAD (Silero, CPU). MIN_SILENCE_MS is how long a pause ends an utterance: lower
# means snappier replies, but a risk of cutting you off mid-thought.
HARU_VAD_START_THRESHOLD=0.5
HARU_VAD_END_THRESHOLD=0.35
HARU_VAD_MIN_SILENCE_MS=500
HARU_VAD_MIN_SPEECH_MS=250
HARU_VAD_PRE_ROLL_MS=300
HARU_VAD_MAX_UTTERANCE_S=30

# Conversation (Stage 4). The persona/system prompt is config/persona.md; edit it
# and restart the gateway. Replies stream and are split into sentences for TTS.
HARU_PERSONA_FILE=/config/persona.md
HARU_CONVERSATION_MAX_MESSAGES=24
HARU_CONVERSATION_IDLE_RESET_S=900
# Includes gpt-oss's hidden reasoning tokens, so don't set it too low.
HARU_LLM_MAX_TOKENS=1024
HARU_LLM_FIRST_TOKEN_TIMEOUT_S=20
HARU_LLM_TOTAL_TIMEOUT_S=60

# Text-to-speech (Stage 5): Kokoro, served by Speaches in the `stt` container over
# the OpenAI-compatible /v1/audio/speech API. It's on the GPU at ~25-35x realtime;
# see the PYTHONHASHSEED workaround in stt.env.
HARU_TTS_BASE_URL=http://stt:8000/v1
HARU_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# Kokoro voices: af_heart, af_bella, af_nicole, af_sky, bf_emma, bm_george, am_michael, ...
HARU_TTS_VOICE=af_heart
HARU_TTS_SPEED=1.0

# debug.ask / debug.say: let an authenticated connection (e.g. haru-terminal-cli)
# inject a question as if a device heard it, or make a device speak. Dev only.
HARU_DEBUG_COMMANDS=1

# Long-term memory (Relevan). RELEVAN_API_KEY lives in secrets.env.
RELEVAN_ORG=your-relevan-org
RELEVAN_MEMORY_INDEX=haru-memories
# Persistent chat log (the memory writer's input); mounted from /opt/haru/data/conversations.
HARU_CHATLOG_DIR=/data/conversations
# Memory writer: process a session after this much silence, or this many new turns.
HARU_MEMORY_IDLE_S=120
HARU_MEMORY_MAX_TURNS=20
HARU_MEMORY_REASONING_EFFORT=medium
HARU_MEMORY_STATE=/data/memory/writer-state.json

# Tools (web search via Firecrawl: FIRECRAWL_API_KEY in secrets.env; weather via Open-Meteo, no key).
# Haru's local time zone (the container itself runs on UTC).
HARU_TIMEZONE=UTC
# Default place for "what's the weather?", e.g. "Denver, Colorado". Unset: she asks.
HARU_HOME_LOCATION=
HARU_UNITS=imperial
HARU_TIMERS_FILE=/data/state/timers.json

# Google Calendar (read-only) via a service account, which sees only calendars explicitly shared with
# it (its client_email, e.g. haru@your-project.iam.gserviceaccount.com). Key file: /opt/haru/config/google-service-account.json.
HARU_GOOGLE_SA_FILE=/config/google-service-account.json
# name=calendar-id pairs, comma separated.
HARU_CALENDARS=mine=you@example.com

# Firecrawl Alexandria: structured-data tools (local businesses, menus, prices, markets, sports...).
# Discovery is free; each run costs the tool's listed credits. Guard rails:
HARU_ALEXANDRIA=1
HARU_ALEXANDRIA_MAX_CREDITS_PER_CALL=25
HARU_ALEXANDRIA_DAILY_CREDITS=500
HARU_ALEXANDRIA_BUDGET_FILE=/data/state/alexandria-budget.json

# GitHub via the official github-mcp-server (bundled in the image), always started with
# GITHUB_READ_ONLY=1 and GITHUB_LOCKDOWN_MODE=1; non-read-only tools are also refused
# client-side. Token: GITHUB_PERSONAL_ACCESS_TOKEN in secrets.env (fine-grained, read-only).
HARU_GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions,notifications
# Allowlist of tool names (without the github_ prefix); empty = the 16-tool default in tools/mcp.py.
# GitHub tools are only offered when the conversation mentions GitHub topics (PRs, issues, CI...).
HARU_GITHUB_TOOLS=
# GitHub org: unscoped searches get org:<this> appended (see tools/mcp.py).
HARU_GITHUB_ORG=

# Capy coding agents (capy.ai); on when CAPY_SERVICE_API_KEY is in secrets.env. Haru watches every thread in
# these projects (ids or codes, comma separated; empty = all) and posts a silent on-screen notification when one
# finishes, fails or needs you. New tasks she starts are read back first, and capped per day.
HARU_CAPY_PROJECTS=
HARU_CAPY_POLL_S=60
HARU_CAPY_DAILY_TASKS=10
HARU_CAPY_STATE=/data/state/capy.json
