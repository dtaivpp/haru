# Speaches (speech-to-text) settings. Keep a loaded model in VRAM indefinitely
# (-1), so the first utterance after idle doesn't pay a model-load delay.
STT_MODEL_TTL=-1
WHISPER__TTL=-1
LOG_LEVEL=info
# No web UI: it isn't needed, and Gradio phones home to api.gradio.app on startup.
ENABLE_UI=false
GRADIO_ANALYTICS_ENABLED=False
# WORKAROUND (Speaches bug, as of the 2025-09 image): the Kokoro TTS executor
# builds its ONNX Runtime provider list from a Python *set*
# (executors/kokoro/model_manager.py), so the order follows string-hash
# randomization and about half of all starts silently run Kokoro on the CPU
# (~10 cores busy, ~6x realtime instead of ~35x on the GPU). Pinning the hash
# seed makes the order deterministic; seed 0 puts CUDAExecutionProvider first
# (verified in the container). The gateway warns at startup if TTS looks CPU-slow.
PYTHONHASHSEED=0
# Default JIT cache limit is 256 MB, too small for Whisper + Kokoro PTX builds.
CUDA_CACHE_MAXSIZE=4294967296
