# Copy to secrets.env on the server (chmod 600). Never commit the real one.
# Minted by scripts/deploy-backend.sh on first deploy; the Pi gets a copy.
HARU_TERMINAL_TOKEN=
# Bearer token for the OpenAI-compatible LLM endpoint (HARU_LLM_BASE_URL).
HARU_LLM_API_KEY=
# Optional: long-term memory (Relevan). Without it, Haru has no long-term memory.
RELEVAN_API_KEY=
# Optional: web search and Alexandria data tools (Firecrawl).
FIRECRAWL_API_KEY=
# Optional: GitHub tools. Use a fine-grained, read-only token.
GITHUB_PERSONAL_ACCESS_TOKEN=
